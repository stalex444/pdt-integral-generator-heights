/-- Certificate identity: `K · Nmat = Σᵢ cᵢ ellᵢ ellᵢᵀ`, entrywise, and `cᵢ ≥ 0`. -/
def certOK : Bool :=
  (List.range 12).all (fun a => (List.range 12).all (fun b =>
    decide (KK * ((Nmat.getD a []).getD b 0) =
      ((List.range 12).map (fun i => cVec.getD i 0 * ((ellM.getD i []).getD a 0) *
        ((ellM.getD i []).getD b 0))).sum))) &&
  cVec.all (fun ci => decide (0 ≤ ci))

theorem certIdentity : certOK = true := by decide +kernel

/-- `lin j s`: the form `ellⱼ` evaluated on the suffix `s = (xⱼ, …, x₁₁)`. -/
def lin (j : ℕ) (s : List ℤ) : ℤ := dot ((ellM.getD j []).drop j) s

/-- The pruned walk: assign coordinate `j` given the suffix `suf = (x_{j+1}, …, x₁₁)` and the
partial lower bound `p`. -/
def go : ℕ → List ℤ → ℤ → Bool
  | j, suf, p => [(-1 : ℤ), 0, 1].all (fun t =>
      let s := t :: suf
      let q := p + cVec.getD j 0 * (lin j s) ^ 2
      decide (KK * 240300 < q) ||
        (match j with
         | 0 => L12.contains s
         | j' + 1 => go j' s q))

def goCheck : Bool := go 11 [] 0

theorem goCheck_true : goCheck = true := by decide +kernel

end RulerSelection.EnumProbe
