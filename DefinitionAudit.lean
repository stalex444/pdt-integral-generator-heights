-- BEGIN HEIGHT DEFINITIONS
-- The three definitions of `HeightT2/Defs.lean` that the compared statements use, with the same
-- text as there (the proof modules are built on that file, which imports Mathlib only).
section HeightDefinitions

open Polynomial

namespace HeightT2

/-- A real algebraic integer `r ≥ 1` exceeding the modulus of every other complex root of its
minimal polynomial over `ℤ` (Lind's convention). -/
def IsPerronNumber (r : ℝ) : Prop :=
  IsIntegral ℤ r ∧ 1 ≤ r ∧ ∀ z ∈ (minpoly ℤ r).aroots ℂ, z ≠ (r : ℂ) → ‖z‖ < r

section Gram

variable {K : Type*} [Field K] [NumberField K]

/-- The `T₂` Gram matrix of a family in a number field: entry `(i, k)` is
`∑_σ σ (b i) * conj (σ (b k))`, over all ring homomorphisms `K →+* ℂ`. It is Hermitian
(`t2Gram_isHermitian`) and real-valued (`t2Gram_eq_ofReal`). -/
noncomputable def t2Gram {ι : Type*} (b : ι → K) : Matrix ι ι ℂ :=
  Matrix.of fun i k => ∑ σ : K →+* ℂ, σ (b i) * star (σ (b k))

/-- The real part of the `T₂` Gram matrix, a real symmetric matrix (`t2GramRe_isHermitian`). -/
noncomputable def t2GramRe {ι : Type*} (b : ι → K) : Matrix ι ι ℝ :=
  Matrix.of fun i k => (t2Gram b i k).re

end Gram

end HeightT2

end HeightDefinitions
-- END HEIGHT DEFINITIONS

namespace DefinitionAudit

open NumberField Polynomial Module

section Height

variable {K : Type*} [Field K] [NumberField K]

/-- `mulHeight₁` on a number field (Mathlib's `NumberField.mulHeight₁_eq`, restated). -/
theorem mulHeight₁_eq_places (x : K) :
    Height.mulHeight₁ x =
      (∏ v : InfinitePlace K, max (v x) 1 ^ v.mult) * ∏ᶠ v : FinitePlace K, max (v x) 1 :=
  NumberField.mulHeight₁_eq x

/-- The infinite part of `mulHeight₁` as a product over the ring homomorphisms `K →+* ℂ`. -/
theorem prod_infinitePlace_eq_prod_embeddings (x : K) :
    ∏ w : InfinitePlace K, max (w x) 1 ^ w.mult = ∏ σ : K →+* ℂ, max 1 ‖σ x‖ := by
  classical
  rw [← Finset.prod_fiberwise Finset.univ InfinitePlace.mk (fun σ : K →+* ℂ => max 1 ‖σ x‖)]
  refine Finset.prod_congr rfl fun w _ => ?_
  have h : ∀ φ ∈ ({φ | InfinitePlace.mk φ = w} : Finset (K →+* ℂ)),
      max 1 ‖φ x‖ = max (w x) 1 := by
    intro φ hφ
    rw [← (Finset.mem_filter.mp hφ).2, InfinitePlace.apply, max_comm]
  rw [Finset.prod_congr rfl h, Finset.prod_const, InfinitePlace.card_filter_mk_eq]

/-- For an algebraic integer, `mulHeight₁ x = ∏_σ max 1 ‖σ x‖`: every finite place contributes
the factor `1`. -/
theorem mulHeight₁_eq_prod_embeddings (x : 𝓞 K) :
    Height.mulHeight₁ (x : K) = ∏ σ : K →+* ℂ, max 1 ‖σ (x : K)‖ := by
  have hfin : ∏ᶠ w : FinitePlace K, max (w (x : K)) 1 = 1 := by
    rw [finprod_congr (fun w => max_eq_right (by
      rw [← FinitePlace.norm_embedding_eq]
      exact FinitePlace.norm_le_one K (FinitePlace.maximalIdeal w) x))]
    exact finprod_one
  rw [NumberField.mulHeight₁_eq, hfin, mul_one, prod_infinitePlace_eq_prod_embeddings]

/-- There are exactly `[K:ℚ]` ring homomorphisms `K →+* ℂ` (Mathlib's
`NumberField.Embeddings.card`, restated). -/
theorem card_embeddings : Fintype.card (K →+* ℂ) = finrank ℚ K :=
  Embeddings.card K ℂ

/-- The normalization: `mulHeight₁ (2 : K) = 2 ^ [K:ℚ]`, so `mulHeight₁` is the height relative
to `K`, not the absolute height when `[K:ℚ] ≥ 2`. -/
theorem mulHeight₁_two : Height.mulHeight₁ (2 : K) = 2 ^ finrank ℚ K := by
  have h := mulHeight₁_eq_prod_embeddings (2 : 𝓞 K)
  have h2 : ((2 : 𝓞 K) : K) = 2 := by norm_cast
  rw [h2] at h
  rw [h]
  have hσ : ∀ σ : K →+* ℂ, max 1 ‖σ (2 : K)‖ = 2 := fun σ => by
    rw [map_ofNat]; norm_num
  rw [Finset.prod_congr rfl (fun σ _ => hσ σ), Finset.prod_const, Finset.card_univ,
    card_embeddings]

/-- `mulHeight₁ 0 = 1` (Mathlib's `Height.mulHeight₁_zero`). -/
theorem mulHeight₁_zero_eq : Height.mulHeight₁ (0 : K) = 1 := Height.mulHeight₁_zero

/-- `mulHeight₁ 1 = 1` (Mathlib's `Height.mulHeight₁_one`). -/
theorem mulHeight₁_one_eq : Height.mulHeight₁ (1 : K) = 1 := Height.mulHeight₁_one

end Height

/-- The finite places count: in `ℚ`, `mulHeight₁ (1/2) = 2`. -/
theorem mulHeight₁_half_rat : Height.mulHeight₁ ((2 : ℚ)⁻¹) = 2 := by
  rw [Height.mulHeight₁_inv, mulHeight₁_two, Module.finrank_self, pow_one]

/-- A root of unity is an element of finite multiplicative order (Mathlib's
`isOfFinOrder_iff_pow_eq_one`, restated). -/
theorem rootOfUnity_iff_isOfFinOrder {K : Type*} [Field K] (x : K) :
    (∃ m : ℕ, 0 < m ∧ x ^ m = 1) ↔ IsOfFinOrder x :=
  isOfFinOrder_iff_pow_eq_one.symm

/-- `M(X − z) = max 1 ‖z‖` (Mathlib's `Polynomial.mahlerMeasure_X_sub_C`, restated). -/
theorem mahlerMeasure_X_sub_C_eq (z : ℂ) : (X - C z).mahlerMeasure = max 1 ‖z‖ :=
  Polynomial.mahlerMeasure_X_sub_C z

/-- `M(X − 2) = 2`. -/
theorem mahlerMeasure_X_sub_two : (X - C 2 : ℂ[X]).mahlerMeasure = 2 := by
  rw [Polynomial.mahlerMeasure_X_sub_C]; norm_num

/-- `M(p) = ‖lead p‖ · ∏ max 1 ‖α‖` over the roots of `p` with multiplicity (Mathlib's
`Polynomial.mahlerMeasure_eq_leadingCoeff_mul_prod_roots`, restated). -/
theorem mahlerMeasure_eq_lead_mul_prod_roots (p : ℂ[X]) :
    p.mahlerMeasure = ‖p.leadingCoeff‖ * (p.roots.map (fun a ↦ max 1 ‖a‖)).prod :=
  Polynomial.mahlerMeasure_eq_leadingCoeff_mul_prod_roots p

/-- The junk value: `minpoly ℤ x = 0` when `x` is not integral (Mathlib's `minpoly.eq_zero`). -/
theorem minpoly_eq_zero_of_not_isIntegral {A : Type*} [CommRing A] [Algebra ℤ A] {x : A}
    (hx : ¬ IsIntegral ℤ x) : minpoly ℤ x = 0 :=
  minpoly.eq_zero hx

/-- On `𝓞 K` it does not occur: `minpoly ℤ x` is monic. -/
theorem minpoly_monic_of_integer {K : Type*} [Field K] [NumberField K] (x : 𝓞 K) :
    (minpoly ℤ (x : K)).Monic :=
  minpoly.monic (RingOfIntegers.isIntegral_coe x)

/-- Linear disjointness is satisfiable: `⊥` is linearly disjoint from every subfield (Mathlib's
`IntermediateField.LinearDisjoint.bot_left`). -/
theorem linearDisjoint_bot (K : Type*) [Field K] [Algebra ℚ K] (F : IntermediateField ℚ K) :
    (⊥ : IntermediateField ℚ K).LinearDisjoint F :=
  IntermediateField.LinearDisjoint.bot_left ℚ K F

/-- What linear disjointness gives on degrees: `[A ⊔ B : ℚ] = [A:ℚ][B:ℚ]` (Mathlib's
`IntermediateField.LinearDisjoint.finrank_sup`, restated). -/
theorem finrank_sup_of_linearDisjoint {K : Type*} [Field K] [Algebra ℚ K]
    {A B : IntermediateField ℚ K} (H : A.LinearDisjoint B) :
    finrank ℚ ↥(A ⊔ B) = finrank ℚ A * finrank ℚ B :=
  H.finrank_sup

open scoped Kronecker in
/-- The entries of the Kronecker product `⊗ₖ` (Mathlib's `Matrix.kroneckerMap_apply`). -/
theorem kroneckerMap_mul_apply {l m n p : Type*} (A : Matrix l m ℂ) (B : Matrix n p ℂ)
    (i : l) (j : n) (k : m) (q : p) : (A ⊗ₖ B) (i, j) (k, q) = A i k * B j q :=
  Matrix.kroneckerMap_apply _ A B _ _

section Gram

variable {K : Type*} [Field K] [NumberField K]

/-- The entries of `t2Gram` (by definition). -/
theorem t2Gram_apply_eq {ι : Type*} (b : ι → K) (i k : ι) :
    HeightT2.t2Gram b i k = ∑ σ : K →+* ℂ, σ (b i) * star (σ (b k)) := rfl

/-- The `T₂` Gram matrix of the one-element family `1` is the degree `[K:ℚ]`. -/
theorem t2GramRe_one_family :
    HeightT2.t2GramRe (fun _ : Fin 1 => (1 : K)) 0 0 = finrank ℚ K := by
  simp [HeightT2.t2GramRe, HeightT2.t2Gram, Embeddings.card K ℂ]

end Gram

/-- Every complex root of the minimal polynomial over `ℤ` of an algebraic integer `r : ℝ` is a
root of each integer polynomial vanishing at `r`. -/
theorem aeval_eq_zero_of_mem_aroots_minpoly {r : ℝ} (hr : IsIntegral ℤ r) {p : ℤ[X]}
    (hp : aeval r p = 0) {z : ℂ} (hz : z ∈ (minpoly ℤ r).aroots ℂ) : aeval z p = 0 := by
  obtain ⟨q, hq⟩ := minpoly.isIntegrallyClosed_dvd hr hp
  rw [mem_aroots] at hz
  rw [hq, map_mul, hz.2, zero_mul]

/-- Every integer `n ≥ 1` is a Perron number. -/
theorem isPerronNumber_intCast (n : ℤ) (hn : 1 ≤ n) : HeightT2.IsPerronNumber (n : ℝ) := by
  have hint : IsIntegral ℤ (n : ℝ) := by
    simpa using isIntegral_algebraMap (R := ℤ) (A := ℝ) (x := n)
  refine ⟨hint, by exact_mod_cast hn, fun z hz hne => ?_⟩
  have hp : aeval (n : ℝ) (X - C n) = 0 := by simp
  have h := aeval_eq_zero_of_mem_aroots_minpoly hint hp hz
  simp only [map_sub, aeval_X, map_intCast, eq_intCast, sub_eq_zero] at h
  exact (hne (by rw [h]; norm_cast)).elim

/-- `1` is a Perron number (Lind's convention). -/
theorem isPerronNumber_one : HeightT2.IsPerronNumber 1 := by
  simpa using isPerronNumber_intCast 1 le_rfl

/-- `2` is a Perron number. -/
theorem isPerronNumber_two : HeightT2.IsPerronNumber 2 := by
  simpa using isPerronNumber_intCast 2 (by norm_num)

/-- A real number below `1` is not a Perron number. -/
theorem not_isPerronNumber_of_lt_one {r : ℝ} (hr : r < 1) : ¬ HeightT2.IsPerronNumber r :=
  fun h => absurd h.2.1 (not_le.2 hr)

/-- `1 + √2` is a Perron number (its conjugate `1 − √2` has modulus `√2 − 1`). -/
theorem isPerronNumber_one_add_sqrt_two : HeightT2.IsPerronNumber (1 + √2) := by
  have hs : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs1 : 1 < √2 := by
    rw [show (1 : ℝ) = √1 by simp]; exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  have hsint : IsIntegral ℤ (√2 : ℝ) := by
    refine IsIntegral.of_pow (n := 2) (by norm_num) ?_
    rw [hs]; simpa using isIntegral_algebraMap (R := ℤ) (A := ℝ) (x := 2)
  have hint : IsIntegral ℤ (1 + √2 : ℝ) := isIntegral_one.add hsint
  refine ⟨hint, by linarith, fun z hz hne => ?_⟩
  have hp : aeval (1 + √2 : ℝ) (X ^ 2 - C 2 * X - 1 : ℤ[X]) = 0 := by
    simp only [map_sub, map_mul, map_pow, aeval_X, map_ofNat, map_one]
    linear_combination hs
  have h := aeval_eq_zero_of_mem_aroots_minpoly hint hp hz
  simp only [map_sub, map_mul, map_pow, aeval_X, map_ofNat, map_one] at h
  have hsC : ((√2 : ℝ) : ℂ) ^ 2 = 2 := by exact_mod_cast hs
  have hfac : (z - ((1 + √2 : ℝ) : ℂ)) * (z - ((1 - √2 : ℝ) : ℂ)) = 0 := by
    push_cast; linear_combination h - hsC
  rcases mul_eq_zero.1 hfac with h1 | h1
  · exact absurd (sub_eq_zero.1 h1) hne
  · rw [sub_eq_zero.1 h1, Complex.norm_real, Real.norm_eq_abs, abs_of_neg (by linarith)]
    linarith

/-- `√2` is not a Perron number: `−√2` is a root of its minimal
polynomial with the same modulus. -/
theorem not_isPerronNumber_sqrt_two : ¬ HeightT2.IsPerronNumber √2 := by
  have hs : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs0 : 0 < √2 := by positivity
  rintro ⟨hint, -, hroots⟩
  have hp : aeval (√2 : ℝ) (X ^ 2 - C 2 : ℤ[X]) = 0 := by
    simp only [map_sub, map_pow, aeval_X, map_ofNat]
    linear_combination hs
  have hmon : (X ^ 2 - C 2 : ℤ[X]).Monic := by
    simpa using monic_X_pow_sub_C (2 : ℤ) (by norm_num : (2 : ℕ) ≠ 0)
  have hdvd := minpoly.isIntegrallyClosed_dvd hint hp
  have hdeg2 : (X ^ 2 - C 2 : ℤ[X]).natDegree = 2 := by
    simpa using natDegree_X_pow_sub_C (n := 2) (r := (2 : ℤ))
  -- the minimal polynomial has degree 2: degree 1 would make `√2` an integer
  have hdeg : (X ^ 2 - C 2 : ℤ[X]).natDegree ≤ (minpoly ℤ (√2 : ℝ)).natDegree := by
    rw [hdeg2]
    by_contra hlt
    push Not at hlt
    have hpos := minpoly.natDegree_pos hint
    have h1 : (minpoly ℤ (√2 : ℝ)).natDegree = 1 := by omega
    have hm := minpoly.monic hint
    obtain ⟨c, hc⟩ : ∃ c : ℤ, minpoly ℤ (√2 : ℝ) = X + C c := ⟨_, hm.eq_X_add_C h1⟩
    have h0 := minpoly.aeval ℤ (√2 : ℝ)
    rw [hc] at h0
    simp only [map_add, aeval_X, map_intCast, eq_intCast] at h0
    have hirr : Irrational √2 := irrational_sqrt_two
    exact hirr.ne_int (-c) (by push_cast; linarith)
  have heq := eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint) hmon hdvd hdeg
  have hmem : (-((√2 : ℝ) : ℂ)) ∈ (minpoly ℤ (√2 : ℝ)).aroots ℂ := by
    rw [← heq, mem_aroots]
    refine ⟨hmon.ne_zero, ?_⟩
    have hsC : ((√2 : ℝ) : ℂ) ^ 2 = 2 := by exact_mod_cast hs
    simp only [map_sub, map_pow, aeval_X, map_ofNat]
    linear_combination hsC
  have hne : (-((√2 : ℝ) : ℂ)) ≠ ((√2 : ℝ) : ℂ) := by
    intro h
    have := congrArg Complex.re h
    simp at this
    linarith
  have := hroots _ hmem hne
  rw [norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hs0] at this
  exact lt_irrefl _ this

end DefinitionAudit

